# Only track starship.toml out of the live ~/.config directory
zsh/.config/*
!zsh/.config/starship.toml

# Claude Code user config: only portable, public-safe settings. CLAUDE.md, agents and skills
# that mention clients live in the private workspace repo instead.
# Runtime state, caches, and secrets (settings.local.json, .credentials.json,
# projects/, history.jsonl, ...) must never be committed, even if they end up
# inside the package by accident.
claude/.claude/*
!claude/.claude/settings.json
!claude/.claude/keybindings.json

# Only the ssh config is tracked. Keys must never end up here (this repo is public).
ssh/.ssh/*
!ssh/.ssh/config
