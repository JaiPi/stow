[safe]
    directory = *
[user]
    name = JaiPi
    email = 29052214+JaiPi@users.noreply.github.com
    signingkey = ~/.ssh/JaiPi.pub
[credential]
    # helper = store
    interactive = false
[commit]
    gpgsign = true
[gpg]
    format = ssh
[gpg.ssh]
    allowedSignersFile = ~/.ssh/allowed_signers
[tag]
	gpgsign = true
[includeIf "gitdir:~/repos/nos/*/"]
	path = ~/workspace/clients/nos/nos.gitconfig
[core]
	autocrlf = input
	eol = lf
